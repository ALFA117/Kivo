# =============================================
# KIVO - Variables de Entorno Requeridas
# Copia este archivo como .env.local y llena los valores
# =============================================

# --- Accesly (Wallet Social Login) ---
# Obtener en: https://accesly.io → Dashboard → Tu app
VITE_ACCESLY_APP_ID=

# --- Trustless Work (Escrow SDK) ---
# Obtener en: https://trustlesswork.com → Developer Portal
VITE_TRUSTLESS_API_KEY=           # Clave para Testnet
VITE_TRUSTLESS_API_KEY_MAINNET=   # Clave para Mainnet

# --- Etherfuse (On/Off Ramp MXN ↔ USDC) ---
# Obtener en: https://etherfuse.com → Developer Console
VITE_ETHERFUSE_API_KEY=
VITE_ETHERFUSE_BASE_URL=https://api.sand.etherfuse.com   # Testnet (sandbox)
# VITE_ETHERFUSE_BASE_URL=https://api.etherfuse.com      # Mainnet

# --- Kivo Platform ---
# Dirección de la cuenta Stellar que cobra la comisión de plataforma
VITE_KIVO_PLATFORM_ADDRESS=

# --- App URL (para generación de QR) ---
# En producción: https://tu-dominio.vercel.app
VITE_APP_URL=http://localhost:5173
